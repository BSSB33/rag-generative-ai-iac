# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your deployment

# Project configuration
project_name = "rag-app"
environment  = "dev"
region       = "us-east-1"

# Bedrock models
bedrock_model_qa        = "anthropic.claude-sonnet-4-5-20250929-v1:0"
bedrock_model_summarize = "anthropic.claude-haiku-4-5-20251001-v1:0"
bedrock_embedding_model = "amazon.titan-embed-text-v2:0"

# S3 configuration
force_destroy = true  # Set to false for production

# API Gateway throttling
api_throttle_rate  = 100   # requests per second
api_throttle_burst = 1000  # burst capacity

# Lambda timeouts (seconds)
lambda_timeout_qa        = 60
lambda_timeout_summarize = 120
lambda_timeout_sync      = 30

# Lambda memory (MB)
lambda_memory_qa        = 512
lambda_memory_summarize = 1024
lambda_memory_sync      = 256

# OpenSearch Serverless capacity (OCUs)
opensearch_capacity_min = 2
opensearch_capacity_max = 4
